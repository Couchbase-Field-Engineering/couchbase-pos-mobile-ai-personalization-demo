# Copy to .env (Expo loads EXPO_PUBLIC_* at build time).

# Demo backend (FastAPI). Simulator/web on the same Mac: localhost. Android emulator: 10.0.2.2.
# Physical phone: your Mac's LAN IP, e.g. http://192.168.1.20:8204
EXPO_PUBLIC_API_URL=http://localhost:8204

# Sync Gateway the Couchbase Lite replicator dials (the backend may override per shopper via SG_PUBLIC_URL).
EXPO_PUBLIC_SG_URL=ws://localhost:4992/pos

# auto = Couchbase Lite in a development build, browser preview in Expo Go / web. Force with cbl | preview.
EXPO_PUBLIC_DB_ENGINE=auto
